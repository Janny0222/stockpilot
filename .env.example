# ------------------------------------------------------------------------------------------------
# StockPilot API: environment variables for PRODUCTION (Render) or any non-Development environment.
# Copy to .env for docker compose overrides, or paste into Render → Environment.
# ASP.NET Core maps "__" (double underscore) to ":" in configuration keys.
# NEVER commit real values. Development defaults live in appsettings.Development.json.
# ------------------------------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production

# Neon: use the POOLED connection string for the app. Add "SSL Mode=Require".
ConnectionStrings__Database=Host=ep-xxxx-pooler.region.aws.neon.tech;Database=stockpilot;Username=xxx;Password=xxx;SSL Mode=Require

# >= 32 random bytes. Generate with:  openssl rand -base64 48
Jwt__SigningKey=
Jwt__Issuer=stockpilot-api
Jwt__Audience=stockpilot-app

# Where the SPA lives (used to build email links) and who may call the API from a browser.
Auth__FrontendBaseUrl=https://stockpilot.pages.dev
Cors__AllowedOrigins__0=https://stockpilot.pages.dev
# Set to false ONLY for a public demo without an email provider.
Auth__RequireConfirmedEmail=true

# Email over SMTP (e.g. Resend: smtp.resend.com, port 465, SslOnConnect, user "resend", password = API key).
Email__Provider=Smtp
Email__SmtpHost=smtp.resend.com
Email__SmtpPort=465
Email__SmtpSecurity=SslOnConnect
Email__SmtpUsername=resend
Email__SmtpPassword=
Email__FromAddress=no-reply@your-verified-domain.com
Email__FromName=StockPilot

# Platform super admin (created on first start if missing). Use a strong, unique password.
Platform__SuperAdmin__Email=
Platform__SuperAdmin__Password=

# Behind Render's / Cloudflare's proxy: trust X-Forwarded-For / -Proto.
ForwardedHeaders__Enabled=true

# Production migrates from CI (EF bundle), not on boot.
Database__MigrateOnStartup=false

# Public API docs at /swagger (fine for a portfolio; set false for a real business).
Swagger__Enabled=true
